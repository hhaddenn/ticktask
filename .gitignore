# --- Secrets ---
# Environment variables with passwords and keys. Never in the repo.
.env
.env.*
# Exception: the example file, without real values, is committed.
!.env.example

# --- Python / Django (backend/) ---
# Virtual environments
.venv/
venv/
# Cache and bytecode
__pycache__/
*.py[cod]
# Test and linter tools
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
# Generated by Django
staticfiles/
media/
# Local database, in case SQLite is used for a quick test
*.sqlite3

# --- Node / React (frontend/) ---
node_modules/
# Build output (Vite uses dist/, Create React App uses build/)
dist/
build/
# npm logs
npm-debug.log*

# --- Editor and OS ---
# Personal VS Code settings; extension recommendations can be committed
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# --- General logs ---
*.log
